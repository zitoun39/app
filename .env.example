# Jawdati environment configuration example
SECRET_KEY=replace-me-with-a-random-string
DATABASE_URI=sqlite:///data/jawdati.db
DEV_DATABASE_URI=sqlite:///data/jawdati_dev.db
TEST_DATABASE_URI=sqlite:///:memory:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_DEFAULT_SENDER=noreply@ade.dz
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
OCR_ENABLED=true
OCR_LANGUAGES=ara,eng
OCR_DEFAULT_LANGUAGE=ara+eng
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS_FILE=/path/to/service-account.json
GOOGLE_DRIVE_BACKUP_FOLDER=Jawdati_Backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL=24
TESSERACT_CMD=/usr/bin/tesseract
MAX_CONTENT_LENGTH=104857600
